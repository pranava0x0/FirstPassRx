      "term": "Prior authorization (PA)",
      "short": "Insurer sign-off first",
      "definition": "Insurer sign-off needed before the drug is covered."
    },
    {
      "term": "Step therapy",
      "short": "Try a preferred drug first",
      "definition": "Must fail a preferred drug first before the plan covers this one."
    }
  ]
}
